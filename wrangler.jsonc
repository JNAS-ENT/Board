{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "board",
  "main": "src/worker.ts",
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS"
  },
  "compatibility_date": "2024-05-02",
  "compatibility_flags": [
    "nodejs_compat"
  ],
  "kv_namespaces": [
    {
      "binding": "WORKSPACE_KV",
      "id": "YOUR_KV_NAMESPACE_ID"
    }
  ]
}
